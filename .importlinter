[importlinter]
root_package = app
include_external_packages = True

# api -> facades -> modules -> shared, never the reverse.
[importlinter:contract:layering]
name = api -> facades -> modules -> shared layering
type = layers
layers =
    api
    facades
    modules
    shared
containers =
    app

# repository.py/service.py/subscribers.py are private (see architecture.md).
[importlinter:contract:users-internals]
name = users module internals are private
type = forbidden
source_modules =
    app.api
    app.facades
    app.modules.products
    app.modules.orders
forbidden_modules =
    app.modules.users.repository
    app.modules.users.service
    app.modules.users.subscribers
ignore_imports =
    app.modules.users.public_api -> app.modules.users.service
    app.modules.users.public_api -> app.modules.users.repository

[importlinter:contract:products-internals]
name = products module internals are private
type = forbidden
source_modules =
    app.api
    app.facades
    app.modules.users
    app.modules.orders
forbidden_modules =
    app.modules.products.repository
    app.modules.products.service
ignore_imports =
    app.modules.products.public_api -> app.modules.products.service
    app.modules.products.public_api -> app.modules.products.repository

[importlinter:contract:orders-internals]
name = orders module internals are private
type = forbidden
source_modules =
    app.api
    app.facades
    app.modules.users
    app.modules.products
forbidden_modules =
    app.modules.orders.repository
    app.modules.orders.service
    app.modules.orders.subscribers
ignore_imports =
    app.modules.orders.public_api -> app.modules.orders.service
    app.modules.orders.public_api -> app.modules.orders.repository

# Blocks other modules' service.py/repository.py from importing this one's
# models.py — models.py itself stays public (see architecture.md).
[importlinter:contract:no-cross-module-model-queries]
name = service/repository layers must not import another module's models
type = forbidden
source_modules =
    app.modules.users.service
    app.modules.users.repository
    app.modules.products.service
    app.modules.products.repository
    app.modules.orders.service
    app.modules.orders.repository
forbidden_modules =
    app.modules.users.models
    app.modules.products.models
    app.modules.orders.models
ignore_imports =
    app.modules.users.service -> app.modules.users.models
    app.modules.users.repository -> app.modules.users.models
    app.modules.products.service -> app.modules.products.models
    app.modules.products.repository -> app.modules.products.models
    app.modules.orders.service -> app.modules.orders.models
    app.modules.orders.repository -> app.modules.orders.models

# Facades may only call public_api, never each other (see architecture.md).
[importlinter:contract:facade-independence]
name = facades do not import each other
type = independence
modules =
    app.facades.user_product_facade
    app.facades.order_facade
